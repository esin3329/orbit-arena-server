{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "orbit-arena-server",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.wrangler-assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws", "/health", "/metrics"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARENA",
        "class_name": "ArenaDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ArenaDO"]
    }
  ]
}
