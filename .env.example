PORT=3000
# 운영 환경에서는 반드시 긴 랜덤 문자열로 변경
TOKEN_SECRET=change-me
LOG_LEVEL=info

# sqlite | supabase
DB_DRIVER=sqlite
SQLITE_PATH=data/game.db

# DB_DRIVER=supabase 일 때 (서버 전용 키 — 브라우저에 노출 금지)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# GitHub 로그인을 켤 때만 설정. URL은 끝에 슬래시가 없는 게임 서버 origin.
SUPABASE_PUBLISHABLE_KEY=
GITHUB_AUTH_ORIGIN=

MATCH_DURATION_SEC=120
# 0 = 한 프로세스, 1 이상 = 지정한 수의 로컬 룸 워커 사용
ROOM_WORKERS=0
MATCH_MAX_PLAYERS=8
MATCH_BOT_FILL_AFTER_MS=4000
MATCH_BOT_FILL_TO=4
MATCH_RECONNECT_GRACE_MS=10000
API_RATE_PER_SEC=10
GUEST_RATE_PER_MIN=5
TRUST_PROXY=0
METRICS_TOKEN=
