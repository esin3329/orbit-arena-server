PORT=3000
# 운영 환경에서는 반드시 긴 랜덤 문자열로 변경
TOKEN_SECRET=change-me
LOG_LEVEL=info

# sqlite | supabase
DB_DRIVER=sqlite
SQLITE_PATH=data/game.db

# DB_DRIVER=supabase 일 때 (서버 전용 키 — 브라우저에 노출 금지)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

MATCH_DURATION_SEC=120
MATCH_MAX_PLAYERS=8
MATCH_BOT_FILL_AFTER_MS=4000
MATCH_BOT_FILL_TO=4
MATCH_RECONNECT_GRACE_MS=10000
API_RATE_PER_SEC=10
GUEST_RATE_PER_MIN=5
